<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground for the Kumo launcher mark.

  Viewport is 108x108dp per the adaptive-icon spec. The safe zone is the central
  72x72dp (radius 36dp from center 54,54); all artwork stays inside it so no mask
  shape (circle/squircle/rounded-rect) can clip the glyph.

  Motif: a shield outline stroked in Kumo Brand orange (#F38020) enclosing a
  tunnel chevron pair. Reads as "protected tunnel" at launcher scale, and uses
  only two Kumo tokens so it stays legible against the dark base layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outline, centered on (54,54), spanning x[32..76] y[28..80]:
         fully within the 72dp safe zone. -->
    <path
        android:pathData="M54,28 L76,37 L76,55 C76,67 66,75 54,80 C42,75 32,67 32,55 L32,37 Z"
        android:strokeColor="#FFF38020"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Upper tunnel chevron -->
    <path
        android:pathData="M45,47 L54,55 L63,47"
        android:strokeColor="#FFE6EDF3"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lower tunnel chevron -->
    <path
        android:pathData="M45,58 L54,66 L63,58"
        android:strokeColor="#FFF38020"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>